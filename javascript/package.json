{
  "name": "not-jwt",
  "version": "1.1.0",
  "description": "Tiny cross-runtime message signer for Node and Web/Edge runtimes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm test && pnpm run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "hmac",
    "jwt",
    "crypto",
    "edge",
    "workers",
    "signature"
  ],
  "author": "Ibrahim Rafi <rafiibrahim8@hotmmail.com>",
  "contributors": [
    {
      "name": "Ibrahim Rafi",
      "email": "rafiibrahim8@hotmmail.com",
      "url": "https://ibrahimrafi.me"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafiibrahim8/not-jwt.git",
    "directory": "javascript"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.1.4",
    "typescript": "^5.9.3",
    "vitest": "^3.1.4"
  }
}
